# ==============================================================================
# AegisScan Environment Configuration
# Copy this file to .env and configure values before starting the application.
# ==============================================================================

# Application Environment (development, staging, production)
APP_ENV=development
ENVIRONMENT=development
DEBUG=false
APP_NAME=AegisScan
APP_VERSION=1.0.0

# Server
HOST=127.0.0.1
PORT=8000

# Security & JWT Authentication
# IMPORTANT: Generate a strong random key in production (e.g. openssl rand -hex 32)
SECRET_KEY=generate_a_strong_random_secret_key_for_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Local SQLite: sqlite:///./aegisscan.db
# PostgreSQL: postgresql://username:password@localhost:5432/aegisscan
DATABASE_URL=sqlite:///./aegisscan.db

# CORS & Frontend Origins (JSON array of strings)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:8000"]
FRONTEND_URL=http://localhost:5173

# Target & SSRF Protection
# Set to false in public SaaS mode to prevent scanning RFC1918 / loopback addresses
ALLOW_PRIVATE_TARGETS=true

# Concurrency & Resource Limits
MAX_CONCURRENT_SCANS=5
MAX_SCAN_TIMEOUT_SECONDS=300
MAX_CRAWL_DEPTH=3
MAX_PAGES=50

# Rate Limiting (requests per minute per IP)
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=20

# Scanner Paths (Optional - system PATH is searched by default)
ZAP_PATH=
NUCLEI_PATH=
SEMGREP_PATH=
DEPENDENCY_CHECK_PATH=

# AI & LLM Features (Optional)
OLLAMA_URL=

# Storage Directories
REPORTS_DIR=./reports
ARTIFACTS_DIR=./artifacts
